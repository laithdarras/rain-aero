{
  "name": "C++ Quickstart",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "CLANG_VERSION": "18",
      "CONAN_VERSION": "2.7.1",
      "CMAKE_VERSION": "3.30.3"
    }
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "runArgs": [
    "--security-opt", "seccomp=unconfined",
    "--cap-add", "SYS_PTRACE"
  ],
  "mounts": [
    "source=cpp-quickstart-conan-cache,target=/home/vscode/.conan2/p,type=volume",
    "source=cpp-quickstart-ccache,target=/home/vscode/.ccache,type=volume"
  ],
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.conan2 /home/vscode/.ccache && ./build.sh --no-build",
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "cheshirekow.cmake-format",
        "vadimcn.vscode-lldb",
        "ms-vscode.cpptools-themes",
        "matepek.vscode-catch2-test-adapter",
        "editorconfig.editorconfig",
        "eamodio.gitlens",
        "ms-python.python"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        "files.trimTrailingWhitespace": true,
        "editor.formatOnSave": true,
        "C_Cpp.intelliSenseEngine": "disabled",
        "clangd.path": "/usr/bin/clangd",
        "clangd.arguments": [
          "--background-index",
          "--clang-tidy",
          "--header-insertion=iwyu",
          "--completion-style=detailed",
          "--function-arg-placeholders",
          "--all-scopes-completion",
          "--pch-storage=memory"
        ],
        "[cpp]": {
          "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
        },
        "[c]": {
          "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
        },
        "[cmake]": {
          "editor.defaultFormatter": "cheshirekow.cmake-format"
        },
        "cmake.configureOnOpen": false,
        "cmake.generator": "Ninja",
        "lldb.executable": "/usr/bin/lldb",
        "cSpell.enabled": false
      }
    }
  }
}
